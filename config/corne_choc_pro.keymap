#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/rgbled_widget.h>

/ {
    chosen {
        zmk,physical-layout = &default_layout;
    };
};

&lt {
    quick-tap-ms = <200>;
    tapping-term-ms = <200>;
    flavor = "tap-preferred";
};

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "QWERTY";
            // -------------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |  [   |   ]   |  Y  |  U   |  I  |  O  |  P  |  \\  |
            // |  ESC |  A  |  S  |  D  |  F  |  G  | RET  |  DEL  |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |              |  N  |  M   |  ,  |  .  |  /  | SHFT |
            //                    | GUI | NUM | CTRL|              |CTRL | FUNC | ALT |
            bindings = <
                &kp TAB   &kp Q &kp W &kp E    &kp R       &kp T &kp LBRC &kp RBRC &kp Y     &kp U      &kp I     &kp O   &kp P    &kp BSLH
                &kp ESC   &kp A &kp S &kp D    &kp F       &kp G &kp RET  &kp DEL  &kp H     &kp J      &kp K     &kp L   &kp SEMI &kp SQT
                &kp LSHFT &kp Z &kp X &kp C    &kp V       &kp B                   &kp N     &kp M      &kp COMMA &kp DOT &kp FSLH &kp RSHFT
                                      &kp LGUI &lt 1 SPACE &kp LCTRL               &kp RCTRL &lt 2 BSPC &kp LALT
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp PG_UP PG_DN &inc_dec_kp C_PREV C_NEXT &inc_dec_kp C_VOL_DN C_VOL_UP>;
        };

        lower_layer {
            display-name = "NUMBER";
            // ----------------------------------------------------------------------------------------------
            // |      |  1  |  2  |  3  |  4  |  5    | PGUP   | HOME  |  6  |  7  |  8  |  9  |  0  |  -   |
            // | CAPS |     |     |     |     |       | PGDN   | END   | LFT | DWN | UP  | RGT |     |  =   |
            // |      |     |     | RST | BOOT| Unlock|                | BATT| CONN|     |     |     |      |
            //                    |     |     |       |                |     |     |     |
            bindings = <
                &trans   &kp N1 &kp N2 &kp N3     &kp N4      &kp N5         &kp PG_UP &kp HOME &kp N6   &kp N7   &kp N8 &kp N9    &kp N0 &kp MINUS
                &kp CAPS &trans &trans &trans     &trans      &trans         &kp PG_DN &kp END  &kp LEFT &kp DOWN &kp UP &kp RIGHT &trans &kp EQUAL
                &trans   &trans &trans &sys_reset &bootloader &studio_unlock                    &ind_bat &ind_con &trans &trans    &trans &trans
                                       &trans     &trans      &trans                            &trans   &trans   &trans
            >;
        };

        raise_layer {
            display-name = "FUNCTION";
            // --------------------------------------------------------------------------------------------
            // |  `   |  1  |  2  |  3  |  4  |  5  | VOLUP  | PRSC  |  6  |  7  |  8  |  9  |  0  | GAME |
            // | F12  | F1  | F2  | F3  | F4  | F5  | VOLDN  | MUTE  | F6  | F7  | F8  | F9  | F10 | F11  |
            // |      | BT0 | BT1 | BT2 | BT3 | BTC |                |     |     |     |     |     |      |
            //                    |     |     |     |                |     |     |     |
            bindings = <
                &kp GRAVE  &kp N1       &kp N2       &kp N3       &kp N4       &kp N5     &kp C_VOL_UP &kp PSCRN  &kp N6 &kp N7 &kp N8 &kp N9 &kp N0  &to 3
                &kp F12    &kp F1       &kp F2       &kp F3       &kp F4       &kp F5     &kp C_VOL_DN &kp C_MUTE &kp F6 &kp F7 &kp F8 &kp F9 &kp F10 &kp F11
                &trans     &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_CLR                         &trans &trans &trans &trans &trans  &trans
                                                     &trans       &trans       &trans                             &trans &trans &trans
            >;
        };

        extra_layer_1 {
            // -------------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |  [   |   ]   |  Y  |  U   |  I  |  O  |  P  |QWERTY|
            // |  ESC |  A  |  S  |  D  |  F  |  G  | RET  |  DEL  |  H  |  J   |  K  |  L  |  UP |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |              |  N  |  M   |  ,  |LEFT |DOWN |RIGHT |
            //                    | GAM2| SPC | ALT |              |CTRL | BSPC | GUI |
            display-name = "GAMING";
            bindings = <
                &kp TAB   &kp Q &kp W &kp E     &kp R      &kp T    &kp LBRC &kp RBRC &kp Y     &kp U    &kp I     &kp O    &kp P    &to 0
                &kp ESC   &kp A &kp S &kp D     &kp F      &kp G    &kp RET  &kp DEL  &kp H     &kp J    &kp K     &kp L    &kp UP   &kp SQT
                &kp LSHFT &kp Z &kp X &kp C     &kp V      &kp B                      &kp N     &kp M    &kp COMMA &kp LEFT &kp DOWN &kp RIGHT
                                      &kp SPACE &mo 4      &kp LALT                   &kp RCTRL &kp BSPC &kp LGUI
            >;
        };

        extra_layer_2 {
            // ----------------------------------------------------------------------------------------------
            // |      |  1  |  2  |  3  |  4  |  5    | PGUP   | HOME  |  6  |  7  |  8  |  9  |  0  |  -   |
            // | CAPS |     |     |     |     |       | PGDN   | END   |     |     |     |     |     |  =   |
            // |      |     |     |     |     |       |                |     |     |     |     |     |      |
            //                    |     |     |       |                |     |     |     |
            display-name = "GAMING 2";
            bindings = <
                &trans   &kp N1 &kp N2 &kp N3 &kp N4 &kp N5 &trans &trans &kp N6 &kp N7 &kp N8 &kp N9 &kp N0 &trans
                &kp CAPS &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans   &trans &trans &trans &trans &trans               &trans &trans &trans &trans &trans &trans
                                       &trans &trans &trans               &trans &trans &trans
            >;
        };
    };
};
